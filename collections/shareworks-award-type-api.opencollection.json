{
  "opencollection": "1.0.0",
  "info": {
    "name": "Shareworks Admin REST Authentication Token Award Type API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Award Type",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GET Award Type (All)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://shareworks.solium.com/rest/admin/v1/company/:companyId/award-type",
            "params": [
              {
                "name": "companyId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve a list of all award types assigned to the specified company"
        }
      ]
    }
  ],
  "bundled": true
}