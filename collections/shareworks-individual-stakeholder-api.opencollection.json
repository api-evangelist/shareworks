{
  "opencollection": "1.0.0",
  "info": {
    "name": "Shareworks Admin REST Authentication Token Individual Stakeholder API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Individual Stakeholder",
        "type": "folder"
      },
      "items": [
        {
